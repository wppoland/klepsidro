# Files excluded from the wp.org build. Ticker is self-contained (no Composer
# runtime dependencies), so /vendor is dev-only and excluded.
/.git
/.github
/.gitignore
/.distignore
/.wp-env.json
/.wp-env.override.json
/node_modules
/vendor
/tests
/scripts
/docs
/composer.json
/composer.lock
/package.json
/package-lock.json
/phpcs.xml.dist
/phpstan.neon.dist
/phpstan-baseline.neon
/README.md
/SPEC.md
/.DS_Store

.DS_Store
/.wordpress-org
/test-results
/playwright-report
/.playwright-mcp

# editor backups (never ship / never a badly_named_files reject)
*~
*.bak

# Translation import tooling (GlotPress PO/MO staging) - never ship in the zip
glotpress-import/

# wp.org builds translations from translate.wordpress.org, so shipping our own
# .po/.mo in the package is a review issue. The .pot stays: it is what the
# translators import from.
/languages/*.po
/languages/*.mo
