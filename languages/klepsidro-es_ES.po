#. Plugin Name of the plugin
#: klepsidro.php
msgid "Klepsidro - Countdown Timer for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: klepsidro.php
msgid "https://plogins.com/plogins-ticker/"
msgstr ""

#. Description of the plugin
#: klepsidro.php
msgid ""
"Show a live sale countdown timer on WooCommerce product pages to create "
"urgency and turn browsers into buyers."
msgstr ""
"Muestre un temporizador de cuenta regresiva de ventas en vivo en las páginas "
"de productos de WooCommerce para crear urgencia y convertir a los visitantes "
"en compradores."

#. Author of the plugin
#: klepsidro.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
