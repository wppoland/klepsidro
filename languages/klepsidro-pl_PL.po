#. Plugin Name of the plugin
#: klepsidro.php
msgid "Klepsidro - Countdown Timer for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: klepsidro.php
msgid "https://plogins.com/plogins-ticker/"
msgstr ""

#. Description of the plugin
#: klepsidro.php
msgid ""
"Show a live sale countdown timer on WooCommerce product pages to create "
"urgency and turn browsers into buyers."
msgstr ""
"Wyświetlaj na żywo zegar odliczający do końca promocji na stronach produktów "
"WooCommerce, aby budować poczucie pilności i zmieniać oglądających w "
"kupujących."

#. Author of the plugin
#: klepsidro.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
